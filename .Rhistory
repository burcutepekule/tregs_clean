param_set_id    = c(62500),
sterile         = c(0),
allow_tregs     = c(1), # THIS NEEDS TO BE 1 AT ALL TIMES!
randomize_tregs = c(0),
macspec_on      = c(0),
ros_level       = c(5:10),
pat_level       = c(8.5,9,9.5,10),
overwrite       = c(1)
)
